{
  "$description": "Meeting At 10, dark. NOT IN FIGMA. Same structure as ACCS DARK; actions invert to the light neutral.",
  "$extensions": {
    "dark": true,
    "sibling": "accs-dark"
  },
  "color": {
    "$type": "color",
    "canvas": {
      "$value": "{color.neutral.950}"
    },
    "surface": {
      "$value": "{color.brand.source-ink}"
    },
    "raised": {
      "$value": "{color.neutral.dark-raised}"
    },
    "text-primary": {
      "$value": "{color.neutral.50}"
    },
    "text-secondary": {
      "$value": "{color.neutral.dark-secondary}"
    },
    "border-default": {
      "$value": "{color.neutral.dark-border}"
    },
    "border-strong": {
      "$value": "{color.neutral.dark-secondary}"
    },
    "action": {
      "default": {
        "$value": "{color.neutral.50}"
      },
      "hover": {
        "$value": "{color.neutral.200}"
      },
      "pressed": {
        "$value": "{color.neutral.dark-secondary}"
      }
    },
    "on-action": {
      "$value": "{color.neutral.950}"
    },
    "focus": {
      "$value": "{color.brand.dark-default}"
    },
    "disabled": {
      "bg": {
        "$value": "{color.neutral.dark-raised}"
      },
      "fg": {
        "$value": "{color.neutral.dark-secondary}"
      }
    },
    "success": {
      "fg": {
        "$value": "{color.success.300}"
      },
      "bg": {
        "$value": "{color.success.950}"
      },
      "on-inverse": {
        "$value": "{color.success.700}"
      }
    },
    "warning": {
      "fg": {
        "$value": "{color.warning.300}"
      },
      "bg": {
        "$value": "{color.warning.950}"
      }
    },
    "danger": {
      "fg": {
        "$value": "{color.danger.300}"
      },
      "bg": {
        "$value": "{color.danger.950}"
      },
      "action": {
        "$value": "{color.danger.300}"
      },
      "action-hover": {
        "$value": "{color.danger.100}"
      },
      "action-pressed": {
        "$value": "{color.danger.400}"
      },
      "on-action": {
        "$value": "{color.neutral.950}"
      }
    },
    "info": {
      "fg": {
        "$value": "{color.brand.dark-default}"
      },
      "bg": {
        "$value": "{color.brand.pressed}"
      }
    },
    "secondary": {
      "default": {
        "$value": "{color.sun.300}"
      },
      "hover": {
        "$value": "{color.sun.100}"
      },
      "pressed": {
        "$value": "{color.sun.50}"
      },
      "on-solid": {
        "$value": "{color.neutral.950}"
      },
      "bg": {
        "$value": "{color.sun.950}"
      },
      "fg": {
        "$value": "{color.sun.300}"
      },
      "border": {
        "$value": "{color.sun.300}"
      }
    },
    "accent": {
      "default": {
        "$value": "{color.brand.dark-default}"
      },
      "hover": {
        "$value": "{color.brand.dark-hover}"
      },
      "pressed": {
        "$value": "{color.brand.dark-pressed}"
      },
      "on-solid": {
        "$value": "{color.neutral.950}"
      },
      "bg": {
        "$value": "{color.brand.pressed}"
      },
      "fg": {
        "$value": "{color.brand.dark-default}"
      },
      "border": {
        "$value": "{color.brand.dark-default}"
      }
    },
    "border-subtle": {
      "$value": "{color.neutral.dark-raised}"
    },
    "inverse": {
      "hover": {
        "$value": "{color.neutral.100}"
      },
      "pressed": {
        "$value": "{color.neutral.200}"
      },
      "focus": {
        "$value": "{color.brand.source-blue}"
      }
    }
  }
}
