{
  "font": {
    "family": {
      "$type": "fontFamily",
      "display": {
        "$value": [
          "Plus Jakarta Sans",
          "ui-sans-serif",
          "system-ui",
          "sans-serif"
        ]
      },
      "body": {
        "$value": [
          "Inter",
