{
  "$description": "Figma 03.2: elevation/0 none, elevation/1 '0 2 8 #1720330D', elevation/2 '0 12 32 #1720331F'. Dark surfaces use a tone step and border instead.",
  "shadow": {
    "$type": "shadow",
    "elevation-0": { "$value": [{ "color": "#17203300", "offsetX": "0px", "offsetY": "0px", "blur": "0px", "spread": "0px" }] },
    "elevation-1": { "$value": [{ "color": "#1720330D", "offsetX": "0px", "offsetY": "2px", "blur": "8px", "spread": "0px" }] },
    "elevation-2": { "$value": [{ "color": "#1720331F", "offsetX": "0px", "offsetY": "12px", "blur": "32px", "spread": "0px" }] }
  }
}
