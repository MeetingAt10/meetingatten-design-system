{
  "$description": "Office Hours look tokens (repo-owned). Every color is a palette or theme token; blends only with transparent. Grammar: \"{ref}\" | \"transparent\" | \"none\" | \"<n>px\" | {\"tint\": ref, \"alpha\": 0-100} (flat translucent color) | {\"highlight\": ref, \"alpha\": 0-100} (1px inset top line) | {\"hatch\": ref, \"alpha\": 0-100} (diagonal hairlines for taken or restricted areas) | [layered parts]. Keys: light + dark, or all. Emitted as --ds-<name> by scripts/build.mjs, validated by scripts/check-tokens.mjs.",
  "sheet-bg": {
    "all": "{color.surface}"
  },
  "sheet-rule": {
    "all": {
      "tint": "{color.text-primary}",
      "alpha": 10
    }
  },
  "block-shadow": {
    "light": "{shadow.lift}",
    "dark": "{shadow.lift-dark}"
  },
  "overlay-bg": {
    "light": "{color.surface}",
    "dark": "{color.raised}"
  },
  "overlay-shadow": {
    "light": "{shadow.overlay}",
    "dark": "{shadow.overlay-dark}"
  },
  "plate-shadow": {
    "light": "none",
    "dark": {
      "highlight": "{color.brand.dark-hover}",
      "alpha": 60
    }
  },
  "btn-highlight": {
    "light": {
      "highlight": "{color.brand.source-white}",
      "alpha": 22
    },
    "dark": {
      "highlight": "{color.brand.source-white}",
      "alpha": 30
    }
  },
  "rule-minor": {
    "all": {
      "tint": "{color.border-subtle}",
      "alpha": 60
    }
  },
  "highlight-community": {
    "light": "{color.accent.100}",
    "dark": "{color.accent.950}"
  },
  "highlight-consult": {
    "light": "{color.secondary.100}",
    "dark": "{color.secondary.950}"
  },
  "highlight-schedule": {
    "light": "{color.info.50}",
    "dark": "{color.info.950}"
  },
  "highlight-neutral": {
    "light": "{color.neutral.100}",
    "dark": "{color.neutral.dark-raised}"
  },
  "highlight-mark": {
    "light": "{color.warning.300}",
    "dark": "{color.warning.950}"
  },
  "today-bg": {
    "light": "{color.info.50}",
    "dark": "{color.neutral.dark-raised}"
  },
  "hatch": {
    "light": {
      "hatch": "{color.hatch-ink}",
      "alpha": 45
    },
    "dark": {
      "hatch": "{color.hatch-ink}",
      "alpha": 55
    }
  },
  "hatch-strong": {
    "light": {
      "hatch": "{color.hatch-ink}",
      "alpha": 80
    },
    "dark": {
      "hatch": "{color.hatch-ink}",
      "alpha": 90
    }
  },
  "scrim": {
    "light": {
      "tint": "{color.brand.source-ink}",
      "alpha": 48
    },
    "dark": {
      "tint": "{color.neutral.950}",
      "alpha": 72
    }
  },
  "art-shadow": {
    "light": {
      "tint": "{color.brand.source-ink}",
      "alpha": 30
    },
    "dark": {
      "tint": "{color.neutral.950}",
      "alpha": 70
    }
  },
  "dim": {
    "all": {
      "tint": "{color.surface}",
      "alpha": 45
    }
  },
  "lift": {
    "all": "-2px"
  },
  "drop": {
    "all": "-6px"
  },
  "rise": {
    "all": "8px"
  },
  "radius-sheet": {
    "all": "{radius.16}"
  },
  "radius-block": {
    "all": "{radius.8}"
  },
  "radius-control": {
    "all": "{radius.10}"
  },
  "radius-chip": {
    "all": "{radius.full}"
  },
  "radius-overlay": {
    "all": "{radius.20}"
  },
  "radius-plate": {
    "all": "{radius.10}"
  },
  "logo-frame": {
    "light": "{color.identity.m10-navy}",
    "dark": "{color.identity.m10-frost}"
  },
  "logo-page": {
    "light": "{color.identity.m10-paper}",
    "dark": "{color.identity.m10-navy}"
  },
  "logo-frame-inverse": {
    "light": "{color.identity.m10-frost}",
    "dark": "{color.identity.m10-navy}"
  },
  "logo-page-inverse": {
    "light": "{color.identity.m10-navy}",
    "dark": "{color.identity.m10-paper}"
  },
  "logo-block": {
    "all": "{color.identity.m10-blue}"
  },
  "logo-numeral": {
    "all": "{color.brand.source-white}"
  },
  "hairline": {
    "all": {
      "tint": "{color.text-primary}",
      "alpha": 8
    }
  },
  "hairline-strong": {
    "all": {
      "tint": "{color.text-primary}",
      "alpha": 14
    }
  },
  "ring-shadow": {
    "light": "{shadow.ring}",
    "dark": "{shadow.ring-dark}"
  },
  "sheet-shadow": {
    "light": "{shadow.sheet}",
    "dark": "{shadow.sheet-dark}"
  },
  "btn-shadow": {
    "light": "{shadow.btn}",
    "dark": "{shadow.btn-dark}"
  },
  "glass-bg": {
    "light": {
      "tint": "{color.canvas}",
      "alpha": 76
    },
    "dark": {
      "tint": "{color.canvas}",
      "alpha": 72
    }
  },
  "glass-overlay-bg": {
    "light": {
      "tint": "{color.surface}",
      "alpha": 82
    },
    "dark": {
      "tint": "{color.raised}",
      "alpha": 78
    }
  },
  "glass-blur": {
    "all": "18px"
  },
  "atmos-cobalt": {
    "light": {
      "tint": "{color.focus}",
      "alpha": 11
    },
    "dark": {
      "tint": "{color.focus}",
      "alpha": 16
    }
  },
  "atmos-emerald": {
    "light": {
      "tint": "{color.secondary.default}",
      "alpha": 8
    },
    "dark": {
      "tint": "{color.secondary.default}",
      "alpha": 10
    }
  },
  "atmos-amber": {
    "light": {
      "tint": "{color.accent.default}",
      "alpha": 8
    },
    "dark": {
      "tint": "{color.accent.default}",
      "alpha": 9
    }
  },
  "radius-frame": {
    "all": "{radius.24}"
  },
  "radius-tick": {
    "all": "{radius.4}"
  }
}
