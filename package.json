{
  "name": "@meetingat10/design-system",
  "version": "1.2.1",
  "description": "Meeting At 10 Design System: tokens, themes, CSS and React components for the ACCS landing, the ACCS portal and admin, and the Meeting At 10 site.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeetingAt10/meetingatten-design-system.git"
  },
  "files": [
    "dist",
    "assets",
    "tokens",
    "docs",
    "foundations",
    "themes",
    "components"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./components.css": "./dist/components.css",
    "./tokens.json": "./dist/tokens.json",
    "./dist/*": "./dist/*",
    "./assets/*": "./assets/*",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/*": {
      "types": "./dist/react/*.d.ts",
      "import": "./dist/react/*.js"
    },
    "./icons": {
      "types": "./dist/react/icons.d.ts",
      "import": "./dist/react/icons.js"
    },
    "./fonts.css": "./dist/fonts.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && npm run build:react",
    "build:react": "node -e \"require('fs').rmSync('dist/react',{recursive:true,force:true})\" && tsc -p tsconfig.react.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check": "npm run build && node scripts/check-contrast.mjs && node scripts/check-tokens.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@number-flow/react": "0.6.2",
    "@phosphor-icons/react": "2.1.10",
    "motion": "14.6.0",
    "react-aria-components": "1.22.1"
  },
  "devDependencies": {
    "@internationalized/date": "3.12.4",
    "@phosphor-icons/core": "2.1.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
