{
  "name": "@meetingat10/design-system",
  "version": "0.2.0",
  "description": "Design tokens, themes and component specs for ACCS (landing + admin) and Meeting At 10.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MeetingAt10/meetingatten-design-system.git"
  },
  "files": [
    "dist",
    "assets",
    "tokens",
    "docs",
    "foundations",
    "themes",
    "components",
    "figma/variables-styles.json",
    "figma/frames-components.json"
  ],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./components.css": "./dist/components.css",
    "./tokens.json": "./dist/tokens.json",
    "./dist/*": "./dist/*",
    "./assets/*": "./assets/*",
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./react/*": {
      "types": "./dist/react/*.d.ts",
      "import": "./dist/react/*.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs && npm run build:react",
    "build:react": "node -e \"require('fs').rmSync('dist/react',{recursive:true,force:true})\" && tsc -p tsconfig.react.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:parity": "node scripts/parity.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "import:figma": "node scripts/import-figma.mjs",
    "check": "npm run build && node scripts/check-contrast.mjs && node scripts/parity.mjs && node scripts/check-tokens.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "react-aria-components": "1.22.1"
  },
  "devDependencies": {
    "@internationalized/date": "3.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
