{
  "name": "@meetingat10/design-system",
  "version": "0.2.0",
  "description": "Design tokens, themes and component specs for ACCS (landing + admin) and Meeting At 10.",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "repository": { "type": "git", "url": "git+https://github.com/MeetingAt10/meetingatten-design-system.git" },
  "files": ["dist", "assets", "tokens", "docs", "foundations", "themes", "components", "templates", "figma/variables-styles.json", "figma/frames-components.json"],
  "exports": {
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
