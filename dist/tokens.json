  "treatments": {
    "card-bg": {
      "light": "{color.surface}",
      "dark": "{color.raised}"
    },
    "card-shadow": {
      "light": "{shadow.elevation-1}",
      "dark": {
        "highlight": "{color.neutral.dark-border}",
        "alpha": 40
      }
    },
    "card-shadow-hover": {
      "light": "{shadow.elevation-2}",
      "dark": {
        "highlight": "{color.neutral.dark-border}",
        "alpha": 60
      }
    },
    "overlay-shadow": {
      "light": "{shadow.elevation-2}",
      "dark": [
        "{shadow.elevation-2}",
        {
          "highlight": "{color.neutral.dark-border}",
          "alpha": 40
        }
      ]
    },
    "wash-accent": {
      "light": {
        "wash": "{color.accent.100}"
      },
      "dark": {
        "wash": "{color.accent.950}"
      }
    },
    "wash-secondary": {
      "light": {
        "wash": "{color.secondary.100}"
      },
      "dark": {
        "wash": "{color.secondary.950}"
      }
    },
    "wash-info": {
      "light": {
        "wash": "{color.info.50}"
      },
      "dark": {
        "wash": "{color.info.950}"
      }
    },
    "scrim": {
      "all": {
        "tint": "{color.brand.source-ink}",
        "alpha": 94
      },
      "light": {
        "tint": "{color.brand.source-ink}",
        "alpha": 94
      },
      "dark": {
        "tint": "{color.brand.source-ink}",
        "alpha": 94
      }
    },
    "lift": {
      "all": "-2px",
      "light": "-2px",
      "dark": "-2px"
    },
    "radius-card": {
      "all": "{radius.12}",
      "light": "{radius.12}",
      "dark": "{radius.12}"
    },
    "radius-tile": {
      "all": "{radius.8}",
